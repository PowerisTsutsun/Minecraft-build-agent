'use strict'

const fs = require('fs')
const path = require('path')
const mineflayer = require('mineflayer')
const { pathfinder, Movements, goals } = require('mineflayer-pathfinder')
const { Vec3 } = require('vec3')

// ---------------------------------------------------------------------------
// Config. Edit these, or override with env vars (MC_HOST=... node index.js).
// ---------------------------------------------------------------------------
const CONFIG = {
  host: process.env.MC_HOST || '127.0.0.1',
  port: parseInt(process.env.MC_PORT || '25566', 10), // 25566 = the 26.1 sandbox; 25565 is the main 26.2 server
  username: process.env.MC_USERNAME || 'BuilderBot',
  // The main server on 25565 runs 26.2 (protocol 776), which mineflayer does
  // not support - 26.1 / protocol 775 is its newest. So the bot targets the
  // 26.1 sandbox server on 25566 instead (see compose.yml's mc-sandbox service).
  // Once `npm update minecraft-data mineflayer` adds 26.2, switch both this
  // and the port back to the main server.
  version: process.env.MC_VERSION || '26.1' // must match the server exactly
  // auth: 'microsoft'  // uncomment only if the server has online-mode=true
}

// Cheap, distinct block the bot pillars up with to reach the roof. Kept
// different from the build materials so pathfinder is allowed to mine its own
// scaffolding back down without ever touching the house.
const SCAFFOLD_BLOCK = process.env.MC_SCAFFOLD || 'dirt'

const DEFAULTS = { width: 7, depth: 6, height: 4, material: 'oak_planks' }
const DOOR_HEIGHT = 2
const MAX_SIZE = 32 // guard against `!build house 999 999 999`

const bot = mineflayer.createBot(CONFIG)
bot.loadPlugin(pathfinder)

let building = false
let cancelled = false

bot.once('spawn', () => {
  configureMovements([])
  bot.chat('BuilderBot online. Try: !build house 7 6 4 oak_planks')
  console.log(`Connected to ${CONFIG.host}:${CONFIG.port} as ${bot.username}`)
})

// ---------------------------------------------------------------------------
// Movement setup.
//
// allow1by1towers lets pathfinder pillar straight up, which is the only way
// the bot can physically reach the roof layer - a player standing on the floor
// cannot reach a block 5 up and 3 across. It needs scaffolding blocks in its
// inventory for that, and it needs permission to mine them back out again.
// Everything the house is made of goes in blocksCantBreak so the pathfinder
// never demolishes what it just built to make itself a shortcut.
// ---------------------------------------------------------------------------
function configureMovements (materials) {
  const mcData = bot.registry || require('minecraft-data')(bot.version)
  const movements = new Movements(bot, mcData)

  movements.allow1by1towers = true
  movements.canDig = true
  movements.allowParkour = false
  movements.maxDropDown = 4

  const scaffoldItem = mcData.itemsByName[SCAFFOLD_BLOCK]
  movements.scafoldingBlocks = scaffoldItem ? [scaffoldItem.id] : [] // sic: library spells it this way

  movements.blocksCantBreak = new Set(movements.blocksCantBreak)
  for (const name of new Set(materials)) {
    const block = mcData.blocksByName[name]
    if (block) movements.blocksCantBreak.add(block.id)
  }

  bot.pathfinder.setMovements(movements)
}

// ---------------------------------------------------------------------------
// Procedural house generator.
//
// Returns a flat array of { pos: Vec3, name: string } in relative coordinates,
// ordered bottom-up (floor -> walls -> roof) so every block always has an
// already-solid neighbor to be placed against.
// ---------------------------------------------------------------------------
function generateHouse ({ width, depth, height, wallBlock, floorBlock, roofBlock, doorGap }) {
  const blocks = []

  for (let x = 0; x < width; x++) {
    for (let z = 0; z < depth; z++) {
      blocks.push({ pos: new Vec3(x, 0, z), name: floorBlock })
    }
  }

  const doorX = Math.floor(width / 2)
  for (let y = 1; y <= height; y++) {
    for (let x = 0; x < width; x++) {
      for (let z = 0; z < depth; z++) {
        const isPerimeter = x === 0 || x === width - 1 || z === 0 || z === depth - 1
        if (!isPerimeter) continue
        if (x === doorX && z === 0 && y <= doorGap) continue // doorway
        blocks.push({ pos: new Vec3(x, y, z), name: wallBlock })
      }
    }
  }

  // Roof sits directly on top of the wall course. Placed from the perimeter
  // inward so the bot always has an adjacent roof block to stand next to and
  // place against, instead of stranding itself over a hole in the middle.
  const roof = []
  for (let x = 0; x < width; x++) {
    for (let z = 0; z < depth; z++) {
      roof.push({ pos: new Vec3(x, height + 1, z), name: roofBlock })
    }
  }
  const cx = (width - 1) / 2
  const cz = (depth - 1) / 2
  roof.sort((a, b) => {
    const da = Math.max(Math.abs(a.pos.x - cx), Math.abs(a.pos.z - cz))
    const db = Math.max(Math.abs(b.pos.x - cx), Math.abs(b.pos.z - cz))
    return db - da // outermost ring first
  })

  return blocks.concat(roof)
}

// ---------------------------------------------------------------------------
// Placement.
// ---------------------------------------------------------------------------
const NEIGHBOR_OFFSETS = [
  new Vec3(0, -1, 0), // block below first - the most reliable face to click
  new Vec3(1, 0, 0), new Vec3(-1, 0, 0),
  new Vec3(0, 0, 1), new Vec3(0, 0, -1),
  new Vec3(0, 1, 0)
]

function countMaterials (blocks) {
  const needed = new Map()
  for (const { name } of blocks) needed.set(name, (needed.get(name) || 0) + 1)
  return needed
}

function countInInventory (name) {
  return bot.inventory.items()
    .filter(i => i.name === name)
    .reduce((sum, i) => sum + i.count, 0)
}

// Scans straight down from `from` to find the first solid block, returning
// the Y just above it - i.e. true standing/floor level, regardless of
// whether the bot happens to currently be a block or two higher than that
// (standing on scaffolding, rubble, or its own half-built wall).
const GROUND_SCAN_MAX_DROP = 8

function findGroundY (from) {
  const x = Math.floor(from.x)
  const z = Math.floor(from.z)
  let y = Math.floor(from.y)
  for (let dropped = 0; dropped < GROUND_SCAN_MAX_DROP; dropped++) {
    const below = bot.blockAt(new Vec3(x, y - 1, z))
    if (below && below.boundingBox === 'block') return y
    y--
  }
  // Nothing solid within range (bot is high up, or world data isn't loaded
  // yet) - fall back to its raw current level rather than guessing further.
  return Math.floor(from.y)
}

// Deriving origin from the bot's current position - even via findGroundY -
// still breaks the moment the bot restarts standing on top of its OWN
// half-built walls: that surface is genuinely solid ground, just not the
// original floor, so "ground level" and "this house's floor" silently
// diverge and the whole structure gets replanned floating at the wrong
// height (0 placed, everything "unreachable", since nothing is adjacent to
// anything in the wrong spot). The only fix that can't get fooled by the
// bot's own progress is to stop re-deriving origin from position at all once
// a build has started: compute it fresh only the first time, then persist it
// and reuse the same coordinates on every resume regardless of where the
// restart left the bot standing.
const ORIGIN_FILE = path.join(__dirname, '.build-origin.json')

function loadSavedOrigin () {
  try {
    const raw = JSON.parse(fs.readFileSync(ORIGIN_FILE, 'utf8'))
    if (typeof raw.x === 'number' && typeof raw.y === 'number' && typeof raw.z === 'number') {
      return new Vec3(raw.x, raw.y, raw.z)
    }
  } catch (err) { /* no saved origin yet, or it's corrupt - compute fresh */ }
  return null
}

function saveOrigin (origin) {
  try {
    fs.writeFileSync(ORIGIN_FILE, JSON.stringify({ x: origin.x, y: origin.y, z: origin.z }))
  } catch (err) {
    console.error('[warn] could not persist build origin:', err.message)
  }
}

// mineflayer's network-facing calls (pathfinding, digging, equipping,
// placing) have each independently been observed to hang forever - never
// resolving *or* rejecting - rather than failing fast, on server versions
// newer than the library was tested against. This first showed up in
// pathfinder.goto(); fixing only that one call site still let the bot wedge
// permanently on dig()/equip()/placeBlock() a build later. So every blocking
// bot call in the placement path goes through this same race now: whichever
// one hangs becomes an ordinary rejected promise (and thus a 'failed' block)
// instead of freezing buildStructure's loop - and the whole process - forever
// with no error in the log.
const ACTION_TIMEOUT_MS = 15000

function withTimeout (promise, label, onTimeout) {
  return Promise.race([
    promise,
    new Promise((_, reject) =>
      setTimeout(() => {
        // Promise.race can't cancel the losing promise - without cleanup the
        // abandoned call (a search, a dig) keeps running in the background
        // even after we've moved on, piling up over a whole build.
        if (onTimeout) { try { onTimeout() } catch (err) { /* nothing to clean up - fine */ } }
        reject(new Error(`${label} timed out`))
      }, ACTION_TIMEOUT_MS))
  ])
}

function gotoWithTimeout (goal) {
  return withTimeout(bot.pathfinder.goto(goal), 'pathfinder', () => bot.pathfinder.stop())
}

function digWithTimeout (block) {
  return withTimeout(bot.dig(block), 'dig', () => bot.stopDigging())
}

function equipWithTimeout (item, destination) {
  return withTimeout(bot.equip(item, destination), 'equip')
}

function placeBlockWithTimeout (ref, face) {
  return withTimeout(bot.placeBlock(ref, face), 'placeBlock')
}

async function walkTo (target, face) {
  // GoalPlaceBlock knows where a player has to stand to legally click a given
  // face, including standing on top of the structure. Fall back to a plain
  // proximity goal if this version of pathfinder doesn't export it.
  if (goals.GoalPlaceBlock) {
    try {
      await gotoWithTimeout(new goals.GoalPlaceBlock(target.clone(), bot.world, {
        range: 4,
        faces: [face],
        half: 'top'
      }))
      return
    } catch (err) {
      // no standing spot for that face (or the search timed out) - try the
      // generic goal below
    }
  }
  await gotoWithTimeout(new goals.GoalNear(target.x, target.y, target.z, 3))
}

// Returns 'placed' | 'skipped' | 'no-material' | 'failed'
async function placeAt (target, blockName) {
  const existing = bot.blockAt(target)
  if (existing && existing.name === blockName) return 'skipped' // re-running a build

  if (existing && existing.boundingBox === 'block') {
    // Something solid is in the way (a hill, a re-run with the wrong material).
    try {
      await gotoWithTimeout(new goals.GoalNear(target.x, target.y, target.z, 3))
      await digWithTimeout(bot.blockAt(target))
    } catch (err) {
      return 'failed'
    }
  }

  const item = bot.inventory.items().find(i => i.name === blockName)
  if (!item) return 'no-material'

  for (const offset of NEIGHBOR_OFFSETS) {
    const ref = bot.blockAt(target.plus(offset))
    if (!ref || ref.boundingBox !== 'block') continue

    const face = offset.scaled(-1) // points from the reference block at the target
    try {
      await walkTo(target, face)
      if (!bot.heldItem || bot.heldItem.name !== blockName) {
        const held = bot.inventory.items().find(i => i.name === blockName)
        if (!held) return 'no-material'
        await equipWithTimeout(held, 'hand')
      }
      await placeBlockWithTimeout(ref, face)
      await bot.waitForTicks(2)
      return 'placed'
    } catch (err) {
      // that face didn't work out - try the next neighbor
    }
  }

  return 'failed'
}

async function buildStructure (origin, blocks) {
  const stats = { placed: 0, skipped: 0, failed: 0, missing: new Set() }

  for (let i = 0; i < blocks.length; i++) {
    if (cancelled) break
    const { pos, name } = blocks[i]
    const result = await placeAt(origin.plus(pos), name)

    if (result === 'placed') stats.placed++
    else if (result === 'skipped') stats.skipped++
    else if (result === 'no-material') stats.missing.add(name)
    else stats.failed++

    if (i > 0 && i % 40 === 0) {
      bot.chat(`...${i}/${blocks.length} blocks`)
    }
  }

  return stats
}

// ---------------------------------------------------------------------------
// Chat commands:
//   !build house <width> <depth> <height> <material>
//   !stop
// ---------------------------------------------------------------------------
bot.on('chat', async (username, message) => {
  if (username === bot.username) return
  const args = message.trim().split(/\s+/)

  if (args[0] === '!stop') {
    if (!building) return bot.chat('Not building anything.')
    cancelled = true
    bot.chat('Stopping after this block.')
    return
  }

  if (args[0] === '!resetbuild') {
    if (building) return bot.chat('Still building - !stop first.')
    try { fs.unlinkSync(ORIGIN_FILE) } catch (err) { /* nothing saved - fine */ }
    bot.chat('Cleared saved build spot - next !build starts a fresh house wherever I\'m standing.')
    return
  }

  if (args[0] !== '!build' || args[1] !== 'house') return

  if (building) {
    bot.chat('Already building - say !stop first.')
    return
  }

  const width = clamp(parseInt(args[2], 10) || DEFAULTS.width)
  const depth = clamp(parseInt(args[3], 10) || DEFAULTS.depth)
  const height = clamp(parseInt(args[4], 10) || DEFAULTS.height)
  const material = args[5] || DEFAULTS.material

  if (!(bot.registry || require('minecraft-data')(bot.version)).blocksByName[material]) {
    bot.chat(`I don't know a block called "${material}".`)
    return
  }

  const blocks = generateHouse({
    width,
    depth,
    height,
    wallBlock: material,
    floorBlock: material,
    roofBlock: material,
    doorGap: DOOR_HEIGHT
  })

  // Warn up front rather than discovering it 200 blocks in.
  const needed = countMaterials(blocks)
  const short = []
  for (const [name, count] of needed) {
    const have = countInInventory(name)
    if (have < count) short.push(`${name} (have ${have}, need ${count})`)
  }
  if (countInInventory(SCAFFOLD_BLOCK) < height + 4) {
    short.push(`${SCAFFOLD_BLOCK} for scaffolding (have ${countInInventory(SCAFFOLD_BLOCK)}, want ${height + 8})`)
  }
  if (short.length) {
    bot.chat(`Short on: ${short.join(', ')} - building what I can.`)
  }

  building = true
  cancelled = false
  configureMovements([material])

  // Build alongside the bot, not on top of it, so it never walls itself in.
  // Ground Y comes from scanning downward, NOT from bot.entity.position.y
  // directly: after a restart mid-build, the bot's saved position can be
  // standing on top of whatever it half-built last time (a wall, scaffolding)
  // rather than the true floor. Using that raw elevation as-is silently
  // replans the entire house floating at the wrong height, where nothing has
  // a solid neighbor to place against - every block then fails as
  // "unreachable" with zero movement, which looks exactly like the bot
  // deciding the job is impossible rather than what it actually is: planning
  // a house in mid-air.
  let origin = loadSavedOrigin()
  if (origin) {
    bot.chat('Resuming previous build - same spot as before.')
  } else {
    const flooredPos = bot.entity.position.floored()
    origin = new Vec3(flooredPos.x + 2, findGroundY(bot.entity.position), flooredPos.z)
    saveOrigin(origin)
  }
  bot.chat(`Building a ${width}x${depth}x${height} house in ${material} (${blocks.length} blocks).`)

  try {
    const stats = await buildStructure(origin, blocks)
    const parts = [`${stats.placed} placed`]
    if (stats.skipped) parts.push(`${stats.skipped} already there`)
    if (stats.failed) parts.push(`${stats.failed} unreachable`)
    if (stats.missing.size) parts.push(`ran out of ${[...stats.missing].join(', ')}`)
    bot.chat(cancelled ? `Stopped. ${parts.join(', ')}.` : `Done! ${parts.join(', ')}.`)
  } catch (err) {
    console.error(err)
    bot.chat(`Build failed: ${err.message}`)
  } finally {
    building = false
    cancelled = false
  }
})

function clamp (n) {
  return Math.max(3, Math.min(MAX_SIZE, n))
}

bot.on('kicked', reason => console.log('Kicked:', reason))
bot.on('error', console.error)
bot.on('end', reason => console.log('Disconnected:', reason))
