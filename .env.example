# Copy to .env, or let ./setup.sh write it for you. Never commit .env.

# Your Minecraft name. RCON is console-level, so the bot only listens to names
# on this list - leave it unset and it refuses every builder rather than handing
# the console to anyone who can type in chat.
BUILDER=YourMinecraftName

# Shared by the server and the bot (compose.yml reads it for both). Any long
# random string; setup.sh generates one.
RCON_PASSWORD=change-me

# true for a normal server. false lets offline/cracked clients join.
ONLINE_MODE=true
