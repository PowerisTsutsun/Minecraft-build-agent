# Copy to .env. Never commit .env.

# RCON password shared by the server and the bot (compose.yml reads it for both).
RCON_PASSWORD=change-me

# Optional. Only the plain-English planner uses it; every !build command works without it.
ANTHROPIC_API_KEY=

# true for a normal server. false lets offline/cracked clients join (the test copy ran that way).
ONLINE_MODE=true
